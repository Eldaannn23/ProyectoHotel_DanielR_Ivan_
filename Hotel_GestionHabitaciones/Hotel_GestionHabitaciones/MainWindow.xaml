<Window x:Class="Hotel_GestionHabitaciones.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel - Gestion de Habitaciones"
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">

        <!-- Fila 0: menu. Fila 1: titulo. Fila 2: pestañas (ocupa el resto) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MENU -->
        <Menu Grid.Row="0">
            <MenuItem Header="Archivo">
                <MenuItem Header="Salir" Click="Salir_Click"/>
            </MenuItem>
            <MenuItem Header="Herramientas">
                <MenuItem Header="Enviar petición errónea al procesador (prueba)" Command="{Binding PruebaErrorCommand}"/>
            </MenuItem>
        </Menu>

        <!-- TITULO -->
        <Border Grid.Row="1" Background="SteelBlue">
            <TextBlock Text="HOTEL - GESTION DE HABITACIONES"
                       Foreground="White"
                       FontSize="22"
                       VerticalAlignment="Center"
                       Margin="15"/>
        </Border>

        <!-- CONTENIDO -->
        <TabControl Grid.Row="2" Margin="10">

            <!-- CLIENTES -->
            <TabItem Header="Clientes">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,15,0">
                        <GroupBox Header="Datos del cliente">
                            <StackPanel>
                                <Label Content="DNI"/>
                                <TextBox Text="{Binding ClienteActual.Dni, Mode=TwoWay}"/>

                                <Label Content="Nombre"/>
                                <TextBox Text="{Binding ClienteActual.Nombre, Mode=TwoWay}"/>

                                <Label Content="Apellidos"/>
                                <TextBox Text="{Binding ClienteActual.Apellidos, Mode=TwoWay}"/>

                                <Label Content="Teléfono"/>
                                <TextBox Text="{Binding ClienteActual.Telefono, Mode=TwoWay}"/>

                                <Label Content="Email"/>
                                <TextBox Text="{Binding ClienteActual.Email, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Añadir" Command="{Binding AnadirClienteCommand}"/>
                            <Button Content="Modificar" Command="{Binding ModificarClienteCommand}"/>
                            <Button Content="Borrar" Command="{Binding BorrarClienteCommand}"/>
                            <Button Content="Limpiar" Command="{Binding LimpiarCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid Grid.Column="1" ItemsSource="{Binding Clientes}"
                  SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="100"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="100"/>
                            <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="100"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="100"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- HABITACIONES -->
            <TabItem Header="Habitaciones">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,15,0">
                        <GroupBox Header="Datos de la habitación">
                            <StackPanel>
                                <Label Content="Número"/>
                                <TextBox Text="{Binding HabitacionActual.Numero, Mode=TwoWay}"/>

                                <Label Content="Tipo"/>
                                <ComboBox ItemsSource="{Binding TiposHabitacion}" SelectedItem="{Binding HabitacionActual.Tipo, Mode=TwoWay}"/>

                                <Label Content="Precio por noche"/>
                                <TextBox Text="{Binding HabitacionActual.Precio, Mode=TwoWay}"/>

                                <Label Content="Estado"/>
                                <ListBox ItemsSource="{Binding EstadosHabitacion}" SelectedItem="{Binding HabitacionActual.Estado, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Añadir" Command="{Binding AnadirHabitacionCommand}" Margin="10"/>
                            <Button Content="Modificar" Command="{Binding ModificarHabitacionCommand}" Margin="10"/>
                            <Button Content="Borrar" Command="{Binding BorrarHabitacionCommand}" Margin="10"/>
                            <Button Content="Limpiar" Command="{Binding LimpiarCommand}" Margin="10"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid Grid.Column="1" ItemsSource="{Binding Habitaciones}"
                              SelectedItem="{Binding HabitacionSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*"/>
                            <DataGridTextColumn Header="Precio por noche" Binding="{Binding Precio}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>





            <!-- RESERVAS -->
            <TabItem Header="Reservas">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,15,0">
                        <GroupBox Header="Datos de la reserva">
                            <StackPanel>
                                <Label Content="Habitación"/>
                                <!-- Clave foranea: enseña el numero pero guarda el Id -->
                                <ComboBox ItemsSource="{Binding Habitaciones}" DisplayMemberPath="Numero" SelectedValuePath="Id"
                              SelectedValue="{Binding ReservaActual.IdHabitacion, Mode=TwoWay}"/>

                                <Label Content="Fecha de entrada"/>
                                <DatePicker SelectedDate="{Binding ReservaActual.FechaEntrada, Mode=TwoWay}"/>

                                <Label Content="Fecha de salida"/>
                                <DatePicker SelectedDate="{Binding ReservaActual.FechaSalida, Mode=TwoWay}"/>

                                <Label Content="Estado"/>
                                <ComboBox ItemsSource="{Binding EstadosReserva}" SelectedItem="{Binding ReservaActual.Estado, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Tabla intermedia Clientes_Reservas -->
                        <GroupBox Header="Cliente">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding Clientes}" DisplayMemberPath="NombreCompleto" SelectedValuePath="Id"
                              SelectedValue="{Binding IdClienteReserva, Mode=TwoWay}"/>
                                <CheckBox Content="Es titular" IsChecked="{Binding EsTitular, Mode=TwoWay}" Margin="0,0,0,8"/>
                                <Button Content="Añadir cliente a la reserva seleccionada" Command="{Binding AnadirClienteAReservaCommand}"/>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Añadir" Command="{Binding AnadirReservaCommand}"/>
                            <Button Content="Modificar" Command="{Binding ModificarReservaCommand}"/>
                            <Button Content="Borrar" Command="{Binding BorrarReservaCommand}"/>
                            <Button Content="Limpiar" Command="{Binding LimpiarCommand}"/>
                        </StackPanel>

                        <!-- Envia la reserva seleccionada a la aplicacion 2 -->
                        <Button Content="Calcular precio (aplicación 2)" Command="{Binding CalcularCommand}"/>
                    </StackPanel>

                    <DataGrid Grid.Column="1" ItemsSource="{Binding Reservas}"
                  SelectedItem="{Binding ReservaSeleccionada, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Habitación" Binding="{Binding NumeroHabitacion}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoHabitacion}" Width="*"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding FechaEntrada, StringFormat=dd/MM/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="Salida" Binding="{Binding FechaSalida, StringFormat=dd/MM/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="Clientes" Binding="{Binding Clientes}" Width="2*"/>
                            <DataGridTextColumn Header="Personas" Binding="{Binding Personas}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                            <DataGridTextColumn Header="Precio total" Binding="{Binding PrecioTotal}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>