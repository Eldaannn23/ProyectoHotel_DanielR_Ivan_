<Window x:Class="Hotel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel - Gestion de Habitaciones"
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITULO -->
        <Border Background="SteelBlue">
            <TextBlock Text="HOTEL - GESTION DE HABITACIONES"
                       Foreground="White"
                       FontSize="22"
                       VerticalAlignment="Center"
                       Margin="15"/>
        </Border>

        <!-- CONTENIDO -->
        <TabControl Grid.Row="1" Margin="10">

            <!-- PESTAÑA HABITACIONES -->
            <TabItem Header="Habitaciones">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- BUSQUEDA -->
                    <StackPanel Margin="10">

                        <TextBlock Text="Buscar habitaciones"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Tipo de habitacion"/>

                        <ComboBox Name="cmbTipo"
                                  Margin="0,5,0,15">
                            <ComboBoxItem Content="Todas"
                                          IsSelected="True"/>
                            <ComboBoxItem Content="Individual"/>
                            <ComboBoxItem Content="Doble"/>
                            <ComboBoxItem Content="Familiar"/>
                        </ComboBox>

                        <TextBlock Text="Fecha de entrada"/>

                        <DatePicker Name="fechaEntrada"
                                    Margin="0,5,0,15"/>

                        <TextBlock Text="Fecha de salida"/>

                        <DatePicker Name="fechaSalida"
                                    Margin="0,5,0,20"/>

                        <Button Content="Buscar habitaciones"
                                Height="35"
                                Click="Buscar_Click"/>

                    </StackPanel>

                    <!-- TABLA -->
                    <StackPanel Grid.Column="1"
                                Margin="10">

                        <TextBlock Text="Habitaciones"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <DataGrid Name="tablaHabitaciones"
                                  Height="300"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Numero"
                                    Binding="{Binding Numero}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Tipo"
                                    Binding="{Binding Tipo}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Precio"
                                    Binding="{Binding Precio}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Estado}"
                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Button Content="Reservar"
                                Width="120"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,15,0,0"
                                Click="Reservar_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- RESERVAS -->
            <TabItem Header="Reservas" Margin="-2,-2,-2,2">
                <TextBlock Text="Apartado de reservas"
                           FontSize="22"
                           Margin="20"/>
            </TabItem>

            <!-- CLIENTES -->
            <TabItem Header="Clientes">
                <TextBlock Text="Apartado de clientes"
                           FontSize="22"
                           Margin="20"/>
            </TabItem>

        </TabControl>

    </Grid>

</Window>